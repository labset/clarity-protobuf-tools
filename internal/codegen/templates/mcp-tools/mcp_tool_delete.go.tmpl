package {{ .Package }}

import (
	"context"

	"connectrpc.com/connect"
	"github.com/modelcontextprotocol/go-sdk/mcp"
	"google.golang.org/protobuf/encoding/protojson"

	{{ .ProtoAlias }} "{{ .ProtoImport }}"
)

type Delete{{ .Model }}Input struct {
	ID string `json:"id"`
}

func (t *{{ .ModelLower }}Tools) delete{{ .Model }}(
	ctx context.Context,
	_ *mcp.CallToolRequest,
	input Delete{{ .Model }}Input,
) (*mcp.CallToolResult, struct{}, error) {
	resp, err := t.handler.Delete{{ .Model }}(ctx, connect.NewRequest(&{{ .ProtoAlias }}.Delete{{ .Model }}Request{
		Id: input.ID,
	}))
	if err != nil {
		return nil, struct{}{}, err
	}
	data, err := protojson.Marshal(resp.Msg)
	if err != nil {
		return nil, struct{}{}, err
	}
	return &mcp.CallToolResult{
		Content: []mcp.Content{&mcp.TextContent{Text: string(data)}},
	}, struct{}{}, nil
}
