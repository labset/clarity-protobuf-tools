package {{ .Package }}

import (
	"{{ .StoreImport }}"
	"github.com/modelcontextprotocol/go-sdk/mcp"
)

type {{ .ModelLower }}Tools struct {
	handler *{{ .ModelLower }}Handler
}

func Register{{ .Model }}Tools(server *mcp.Server, deps {{ .Model }}Deps) {
	t := &{{ .ModelLower }}Tools{
		handler: &{{ .ModelLower }}Handler{
			store: db.New(deps.Pool),
		},
	}
{{- range .Operations }}
	mcp.AddTool(server, &mcp.Tool{
		Name:        "{{ .ToolName }}",
		Description: "{{ .Description }}",
	}, t.{{ .MethodName }})
{{- end }}
}
