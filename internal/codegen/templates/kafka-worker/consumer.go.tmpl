package {{ .Package }}

import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/segmentio/kafka-go"
)
{{ range .Subscribers }}
// {{ $.Model }}{{ .Title }}Handler handles {{ .Lower }} events for {{ $.Model }}.
type {{ $.Model }}{{ .Title }}Handler interface {
	Handle{{ $.Model }}Event(ctx context.Context, envelope EventEnvelope) error
}
{{ end }}
// {{ .Model }}ConsumerDeps holds dependencies for {{ .Model }} Kafka consumers.
type {{ .Model }}ConsumerDeps struct {
	Brokers []string
}
{{ range .Subscribers }}
// Run{{ $.Model }}{{ .Title }}Consumer starts a Kafka consumer for {{ $.Model }} {{ .Lower }} events.
func Run{{ $.Model }}{{ .Title }}Consumer(ctx context.Context, deps {{ $.Model }}ConsumerDeps, handler {{ $.Model }}{{ .Title }}Handler) error {
	reader := kafka.NewReader(kafka.ReaderConfig{
		Brokers: deps.Brokers,
		Topic:   {{ $.ModelLower }}Topic,
		GroupID: "{{ $.Domain }}.{{ $.ModelSnake }}.{{ .Lower }}",
	})
	defer reader.Close()
	return consume{{ $.Model }}Events(ctx, reader, handler.Handle{{ $.Model }}Event)
}
{{ end }}
func consume{{ .Model }}Events(ctx context.Context, reader *kafka.Reader, handle func(context.Context, EventEnvelope) error) error {
	for {
		msg, err := reader.ReadMessage(ctx)
		if err != nil {
			return err
		}
		var envelope EventEnvelope
		if err := json.Unmarshal(msg.Value, &envelope); err != nil {
			return fmt.Errorf("unmarshaling {{ .ModelSnake }} event: %w", err)
		}
		if err := handle(ctx, envelope); err != nil {
			return fmt.Errorf("handling {{ .ModelSnake }} event: %w", err)
		}
	}
}
