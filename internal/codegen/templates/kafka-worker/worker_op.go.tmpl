package {{ .Package }}

import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/riverqueue/river"
	"github.com/segmentio/kafka-go"

	"{{ .OutboxImport }}"
)

type {{ .OpLower }}{{ .Model }}Worker struct {
	river.WorkerDefaults[outbox.{{ .OpTitle }}{{ .Model }}EventArgs]
	writer *kafka.Writer
}

func (w *{{ .OpLower }}{{ .Model }}Worker) Work(ctx context.Context, job *river.Job[outbox.{{ .OpTitle }}{{ .Model }}EventArgs]) error {
	envelope := EventEnvelope{
		EntityID:   job.Args.EntityID.String(),
		Operation:  "{{ .OpLower }}",
{{- if .HasFieldMask }}
		FieldMask:  job.Args.FieldMask,
{{- end }}
		OccurredAt: job.Args.OccurredAt,
	}

	data, err := json.Marshal(envelope)
	if err != nil {
		return fmt.Errorf("marshaling {{ .OpLower }} {{ .ModelSnake }} event: %w", err)
	}

	return w.writer.WriteMessages(ctx, kafka.Message{
		Topic: {{ .ModelLower }}Topic,
		Key:   []byte(envelope.EntityID),
		Value: data,
	})
}
