package {{ .Package }}

import (
	"net/http"

	"connectrpc.com/connect"

	{{ .ConnectAlias }} "{{ .ConnectImport }}"
)

// {{ .Service }}Deps holds the dependencies for the {{ .Service }} handler.
type {{ .Service }}Deps struct{}

type {{ .ServiceLower }}Handler struct {
	{{ .ConnectAlias }}.Unimplemented{{ .Service }}Handler
}

// New{{ .Service }}Handler creates a Connect handler for {{ .Service }}.
func New{{ .Service }}Handler(deps {{ .Service }}Deps, opts ...connect.HandlerOption) (string, http.Handler) {
	h := &{{ .ServiceLower }}Handler{}
	return {{ .ConnectAlias }}.New{{ .Service }}Handler(h, opts...)
}
